{
    "name": "emericklaw/sqlanywhere-pdo",
    "description": "PDO-compatible userland wrapper around the ext-sqlanywhere (sasql_*) procedural extension for SAP SQL Anywhere",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-sqlanywhere": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "EmerickLaw\\SqlAnywherePdo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EmerickLaw\\SqlAnywherePdo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
